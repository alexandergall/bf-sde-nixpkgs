{
    "open-p4studio-model": {
        "enabled": 1,
        "hidden": false,
        "description": "Open-source SDE without ASIC support",
        "nixexprinput": "src",
        "nixexprpath": "release.nix",
        "checkinterval": 300,
        "schedulingshares": 100,
        "enableemail": false,
        "emailoverride": "",
        "keepnr": 3,
        "inputs": {
            "src": { "type": "git", "value": "https://github.com/alexandergall/bf-sde-nixpkgs.git open-p4studio", "emailresponsible": false },
            "withAsic": { "type": "boolean", "value": "false" }
        }
    },
    "open-p4studio-asic": {
        "enabled": 1,
        "hidden": false,
        "description": "Hybrid SDE with ASIC support",
        "nixexprinput": "src",
        "nixexprpath": "release.nix",
        "checkinterval": 300,
        "schedulingshares": 100,
        "enableemail": false,
        "emailoverride": "",
        "keepnr": 3,
        "inputs": {
            "src": { "type": "git", "value": "https://github.com/alexandergall/bf-sde-nixpkgs.git open-p4studio", "emailresponsible": false },
            "withAsic": { "type": "boolean", "value": "true" }
        }
    },
    "test-cases": {
        "enabled": 1,
        "hidden": false,
        "description": "SDE test cases",
        "nixexprinput": "src",
        "nixexprpath": "release-test-cases.nix",
        "checkinterval": 300,
        "schedulingshares": 100,
        "enableemail": false,
        "emailoverride": "",
        "keepnr": 3,
        "inputs": {
            "src": { "type": "git", "value": "https://github.com/alexandergall/bf-sde-nixpkgs.git open-p4studio", "emailresponsible": false },
            "withAsic": { "type": "boolean", "value": "false" }
        }
    }
}
